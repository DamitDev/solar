API_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=8001
MODELS_DIR=./models
SOLAR_CONTROL_URL=ws://localhost:8015/ws/host-channel
INSECURE=false

# Harbor registry credentials (required for repo:// model pulls)
HARBOR_URL=https://imgrepo.harbor.hu
HARBOR_USERNAME=
HARBOR_PASSWORD=

# HuggingFace Hub token (optional for public models, required for gated models)
HF_TOKEN=

# SGLang backend (optional, NVIDIA hosts only)
# Virtualenv SGLang is installed into; empty falls back to `sglang` on PATH
SGLANG_VENV_PATH=
# Root directory for SGLang's file-backed prompt cache; per-instance subdirs
# are deleted on stop (transiently visible as .trash-<uuid>) and leftovers
# swept at startup, so use a dedicated path and never share it between hosts
SGLANG_PROMPT_CACHE_DIR=

# vLLM backend (optional, NVIDIA hosts only)
# Virtualenv vLLM is installed into; empty falls back to `vllm` on PATH
VLLM_VENV_PATH=

# Docker execution layer (S-022)
JOBS_DIR=./jobs
CONTAINER_UID=1000
CONTAINER_GID=1000
HF_CACHE_DIR=./hf-cache

# Key handed to spawned backend processes via the environment (IT Sec #97:
# never the CLI argument list -- ps reads argv in the clear). llama.cpp
# reads LLAMA_API_KEY, vLLM reads VLLM_API_KEY, SGLang reads
# SGLANG_API_KEY, the HuggingFace server reads SOLAR_API_KEY. The
# per-backend --api-key CLI flag stays as an optional override.
SOLAR_API_KEY=
